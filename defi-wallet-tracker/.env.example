# DeFi Wallet Tracker — API Keys
# Copy this file to .env and fill in your keys

# Free tier: 5 req/s, 100k/day — https://etherscan.io/myapikey
# One key covers ETH, BSC, Base, Arbitrum, Polygon, Optimism, Avalanche
ETHERSCAN_API_KEY=

# Demo key: 30 req/min — https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Birdeye — best for Solana pricing + top-trader discovery — https://bds.birdeye.so
BIRDEYE_API_KEY=

# GMGN.ai smart-money leaderboard (Solana + Base) — https://gmgn.ai
GMGN_API_KEY=

# Cielo Finance — on-chain PnL scoring — https://cielo.finance/developer
CIELO_API_KEY=

# Free tier: 40,000 CU/day — https://moralis.io
MORALIS_API_KEY=

# Free tier: 100k credits/month — https://goldrush.dev
COVALENT_API_KEY=

# Optional — paid; best smart-money labels
NANSEN_API_KEY=

# Optional — paid; entity identification
ARKHAM_API_KEY=

# Minimum win rate threshold (default: 85)
MIN_WIN_RATE=85

# Minimum multiplier for "early entry" detection (default: 5)
MIN_MULTIPLIER=5
